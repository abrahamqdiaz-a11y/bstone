# Copy to .env.local for development. In Netlify, set these under
# Site configuration → Environment variables. Never commit real values.

# Canonical origin (no trailing slash). Defaults to https://briarstoneprep.com.
NEXT_PUBLIC_SITE_URL=https://briarstoneprep.com

# Set to "false" to emit noindex + X-Robots-Tag + disallow-all robots.txt.
# Every Netlify context except production (deploy-preview, branch-deploy, dev)
# is blocked automatically from the CONTEXT variable; see src/lib/indexing.ts.
NEXT_PUBLIC_ALLOW_INDEXING=true

# ── Lead delivery (production requires at least one) ─────────────────────────
# Generic CRM webhook (Zapier, Make, HubSpot workflow, custom endpoint). Receives JSON.
LEAD_WEBHOOK_URL=
# Optional: HMAC-SHA256 secret; signature sent as X-Briarstone-Signature: sha256=<hex>
LEAD_WEBHOOK_SECRET=

# Email notifications through Resend (https://resend.com). All three required.
RESEND_API_KEY=
LEAD_EMAIL_TO=
LEAD_EMAIL_FROM=

# ── Spam protection (optional; honeypot + timing checks always run) ─────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional; loads only after visitor consent) ──────────────────
NEXT_PUBLIC_GTM_ID=
